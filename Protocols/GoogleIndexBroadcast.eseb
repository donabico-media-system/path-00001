#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
[ESEB MASTER PROTOCOL SOURCE]
MODULE: GoogleIndexBroadcast
STAMP: V-STAMP-24 | ANCHOR: ¢24 | BRAND: DONABICO MEDIA SYSTEM
STANDARD: 04THU (Thực Dụng - Thực Tế - Thực Tiễn - Thực Chiến 100%)
AUTO-6D: Auto-Detect Repo & CNAME
"""

import os
import sys
import json
import urllib.request
import urllib.parse

def auto_discover_context():
    repo = os.environ.get("GITHUB_REPOSITORY", "donabico-media-system/path-00001")
    repo_name = repo.split('/')[-1] if '/' in repo else "path-00001"
    domain = f"https://donabico.com/{repo_name}"
    
    if os.path.exists("CNAME"):
        try:
            with open("CNAME", "r", encoding="utf-8") as f:
                cname_val = f.read().strip()
                if cname_val:
                    cname_clean = cname_val.replace("https://", "").replace("http://", "").strip("/")
                    domain = f"https://{cname_clean}/{repo_name}"
        except Exception:
            pass
            
    return {
        "repo": repo,
        "domain": domain,
        "token": os.environ.get("CLASSIC_API_TOKEN", ""),
        "stamp": "V-STAMP-24",
        "anchor": "¢24"
    }

def generate_google_seo_system(ctx):
    os.makedirs("Protocols", exist_ok=True)
    
    # 1. Sinh sitemap.xml chuẩn Googlebot XML Schema
    sitemap_content = f"""<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{ctx['domain']}/</loc>
    <lastmod>2026-11-02</lastmod>
    <changefreq>always</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
"""
    with open("sitemap.xml", "w", encoding="utf-8") as f:
        f.write(sitemap_content)

    # 2. Sinh robots.txt nâng cấp chuẩn BigTech & AI Crawler Matrix
    robots_content = f"""# DONABICO MEDIA SYSTEM | ESEB LIVING ENGINE V3000-Ω
User-agent: Googlebot
User-agent: Googlebot-Image
User-agent: Googlebot-News
User-agent: Bingbot
User-agent: GPTBot
User-agent: ClaudeBot
User-agent: PerplexityBot
Allow: /
Crawl-delay: 0

User-agent: *
Allow: /
Disallow: /Protocols/*.eseb
Disallow: /.github/

User-agent: AhrefsBot
User-agent: SemrushBot
Disallow: /

Sitemap: {ctx['domain']}/sitemap.xml
"""
    with open("robots.txt", "w", encoding="utf-8") as f:
        f.write(robots_content)

    # 3. Sinh Client Living Entity (.ehc) - Dynamic Favicon + Schema JSON-LD + F12 Log Pulse 2.5s
    ehc_content = f"""/* ESEB GOOGLE INDEXING CLIENT ENTITY | {ctx['stamp']} | {ctx['anchor']} */
(function() {{
    'use strict';
    
    // Dynamic Favicon Suppressor (Chặn 404 Console)
    if (!document.querySelector("link[rel*='icon']")) {{
        const link = document.createElement('link');
        link.type = 'image/x-icon';
        link.rel = 'shortcut icon';
        link.href = 'data:image/x-icon;base64,AAABAAEAEBAAAAEAIABoBAAAFgAAACgAAAAQAAAAEAAAAAEAIAAAAAAAAAIAAAAAAAAAAAAAAAAAAAAAAAD///8A';
        document.getElementsByTagName('head')[0].appendChild(link);
    }}

    // Dynamic Schema.org JSON-LD Injector cho Googlebot Parsing
    if (!document.getElementById("eseb-google-schema")) {{
        const schema = document.createElement('script');
        schema.id = "eseb-google-schema";
        schema.type = 'application/ld+json';
        schema.text = JSON.stringify({{
            "@context": "https://schema.org",
            "@type": "TechArticle",
            "headline": "DONABICO MEDIA SYSTEM RESEARCH | High-Density Neural System Architecture",
            "url": "{ctx['domain']}/",
            "author": {{
                "@type": "Organization",
                "name": "DONABICO MEDIA SYSTEM",
                "url": "https://donabico.com/"
            }},
            "publisher": {{
                "@type": "Organization",
                "name": "DONABICO MEDIA SYSTEM"
            }},
            "mainEntityOfPage": "{ctx['domain']}/",
            "datePublished": "2026-11-02",
            "dateModified": "2026-11-02"
        }});
        document.getElementsByTagName('head')[0].appendChild(schema);
    }}

    console.log("%c[{ctx['stamp']}] [GOOGLE_SYSTEM_READY] Client Living Pulse Active | Target: {ctx['domain']}/", "color: #00ff00; font-weight: bold;");

    setInterval(() => {{
        console.log(JSON.stringify({{
            pulse: "LIVE",
            module: "GoogleIndexBroadcast",
            stamp: "{ctx['stamp']}",
            anchor: "{ctx['anchor']}",
            domain: "{ctx['domain']}/",
            entropy: "0.00000000000000"
        }}));
    }}, 2500);
}})();
"""
    with open("Protocols/GoogleIndexBroadcast.ehc", "w", encoding="utf-8") as f:
        f.write(ehc_content)

    # 4. Sinh Serverless Runner Engine (.js) - Ping Googlebot API Server-to-Server
    js_content = f"""/* ESEB GOOGLE INDEXING RUNNER ENGINE | {ctx['stamp']} | {ctx['anchor']} */
const https = require('https');
const {{ URL }} = require('url');

const CONFIG = {{
    stamp: "{ctx['stamp']}",
    anchor: "{ctx['anchor']}",
    domain: "{ctx['domain']}",
    sitemap: "{ctx['domain']}/sitemap.xml"
}};

console.log(`[${{CONFIG.stamp}}] STARTING GOOGLE SITEMAP PING ENGINE...`);
console.log(`--> Target Domain: ${{CONFIG.domain}}/`);

const pingUrl = `https://www.google.com/ping?sitemap=${{encodeURIComponent(CONFIG.sitemap)}}`;
const parsedUrl = new URL(pingUrl);

const options = {{
    hostname: parsedUrl.hostname,
    port: 443,
    path: parsedUrl.pathname + parsedUrl.search,
    method: 'GET',
    headers: {{
        'User-Agent': 'Mozilla/5.0 (compatible; ESEB-GoogleBot-Ping/1.0)'
    }}
}};

const req = https.request(options, (res) => {{
    console.log(`[${{CONFIG.stamp}}] GOOGLE SITEMAP PING STATUS: ${{res.statusCode}}`);
    process.exit(0);
}});

req.on('error', (e) => {{
    console.error(`[${{CONFIG.stamp}}] GOOGLE PING ERROR: ${{e.message}}`);
    process.exit(0);
}});

req.end();
setTimeout(() => process.exit(0), 4000);
"""
    with open("Protocols/GoogleIndexBroadcast.js", "w", encoding="utf-8") as f:
        f.write(js_content)

    print(f"[{ctx['stamp']}] GOOGLE INDEX SYSTEM REGENERATED: sitemap.xml, robots.txt, .ehc & .js ready!")

def execute_direct_python_ping(ctx):
    sitemap_url = f"{ctx['domain']}/sitemap.xml"
    google_ping_url = f"https://www.google.com/ping?sitemap={urllib.parse.quote(sitemap_url)}"
    
    try:
        req = urllib.request.Request(
            google_ping_url, 
            headers={'User-Agent': 'Mozilla/5.0 (compatible; ESEB-Master-Python/1.0)'}
        )
        with urllib.request.urlopen(req, timeout=5) as response:
            print(f"[{ctx['stamp']}] Direct Python Google Sitemap Ping HTTP Status: {response.status}")
    except Exception as e:
        print(f"[{ctx['stamp']}] Python Direct Ping Pass (Handled via Cloud Runner): {e}")

if __name__ == "__main__":
    context = auto_discover_context()
    generate_google_seo_system(context)
    execute_direct_python_ping(context)
