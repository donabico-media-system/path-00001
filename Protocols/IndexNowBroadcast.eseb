#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
[ESEB MASTER PROTOCOL SOURCE]
MODULE: IndexNowBroadcast
STAMP: V-STAMP-24 | ANCHOR: ¢24 | BRAND: DONABICO MEDIA SYSTEM
STANDARD: 04THU (Thực Dụng - Thực Tế - Thực Tiễn - Thực Chiến 100%)
AUTO-6D: Auto-Detect Repo & CNAME
"""

import os
import sys
import json

def auto_discover_context():
    repo = os.environ.get("GITHUB_REPOSITORY", "donabico-media-system/path-00001")
    domain = f"https://{repo.split('/')[0]}.github.io/{repo.split('/')[1]}"
    
    if os.path.exists("CNAME"):
        try:
            with open("CNAME", "r", encoding="utf-8") as f:
                cname_val = f.read().strip()
                if cname_val:
                    domain = f"https://{cname_val}"
        except Exception:
            pass
            
    return {
        "repo": repo,
        "domain": domain,
        "token": os.environ.get("CLASSIC_API_TOKEN", ""),
        "stamp": "V-STAMP-24",
        "anchor": "¢24"
    }

def generate_dual_outputs(ctx):
    os.makedirs("Protocols", exist_ok=True)
    
    # 1. Sinh Client Entity (.ehc) - Phát Pulse F12 2.5s + Gửi Direct Fetch Broadcast Log
    ehc_content = f"""/* ESEB CLIENT LIVING ENTITY | {ctx['stamp']} | {ctx['anchor']} */
(function() {{
    'use strict';
    console.log("%c[{ctx['stamp']}] [SYSTEM_READY] Client Living Pulse 2.5s Active | Domain: {ctx['domain']}", "color: #00ff00; font-weight: bold;");
    
    // Client-Side Direct Ping Log
    const broadcastPayload = {{
        host: "{ctx['domain'].replace('https://', '').replace('http://', '').split('/')[0]}",
        key: "24242424242424242424242424242424",
        keyLocation: "{ctx['domain']}/24242424242424242424242424242424.txt",
        urlList: ["{ctx['domain']}/", "{ctx['domain']}/sitemap.xml"]
    }};
    
    console.log("%c[{ctx['stamp']}] [CLIENT_BROADCAST] Pinging IndexNow Gateways from Browser...", "color: #00ffff;");
    fetch("https://api.indexnow.org/indexnow", {{
        method: "POST",
        headers: {{ "Content-Type": "application/json; charset=utf-8" }},
        body: JSON.stringify(broadcastPayload)
    }}).then(res => {{
        console.log("%c[{ctx['stamp']}] [CLIENT_BROADCAST_STATUS] IndexNow Core Response: " + res.status, "color: #00ff00;");
    }}).catch(err => {{
        console.log("%c[{ctx['stamp']}] [CLIENT_BROADCAST_PASS] Handled via Cloud Runner", "color: #ffaa00;");
    }});

    setInterval(() => {{
        console.log(JSON.stringify({{
            pulse: "LIVE",
            stamp: "{ctx['stamp']}",
            anchor: "{ctx['anchor']}",
            entropy: "0.00000000000000"
        }}));
    }}, 2500);
}})();
"""
    with open("Protocols/IndexNowBroadcast.ehc", "w", encoding="utf-8") as f:
        f.write(ehc_content)

    # 2. Sinh Serverless Runner Engine (.js) - Phát sóng máy chủ ngoại biên
    js_content = f"""/* ESEB SERVERLESS RUNNER ENGINE | {ctx['stamp']} | {ctx['anchor']} */
const https = require('https');
const {{ URL }} = require('url');

const CONFIG = {{
    stamp: "{ctx['stamp']}",
    anchor: "{ctx['anchor']}",
    repo: "{ctx['repo']}",
    domain: "{ctx['domain']}",
    key: "24242424242424242424242424242424",
    endpoints: [
        "https://api.indexnow.org/indexnow",
        "https://www.bing.com/indexnow"
    ]
}};

console.log(`[${{CONFIG.stamp}}] [${{CONFIG.anchor}}] STARTING SERVERLESS RUNNER BROADCAST PIPELINE...`);
console.log(`--> Target Domain: ${{CONFIG.domain}}`);

const parsedDomain = new URL(CONFIG.domain);
const host = parsedDomain.hostname;

const payload = JSON.stringify({{
    host: host,
    key: CONFIG.key,
    keyLocation: `${{CONFIG.domain}}/${{CONFIG.key}}.txt`,
    urlList: [
        `${{CONFIG.domain}}/`,
        `${{CONFIG.domain}}/sitemap.xml`
    ]
}});

let completed = 0;

CONFIG.endpoints.forEach((targetUrl) => {{
    const targetParsed = new URL(targetUrl);
    const options = {{
        hostname: targetParsed.hostname,
        port: 443,
        path: targetParsed.pathname,
        method: 'POST',
        headers: {{
            'Content-Type': 'application/json; charset=utf-8',
            'Content-Length': Buffer.byteLength(payload),
            'User-Agent': 'ESEB-V3000-Serverless-Runner'
        }}
    }};

    const req = https.request(options, (res) => {{
        console.log(`[${{CONFIG.stamp}}] BROADCAST TO ${{targetParsed.hostname}} -> HTTP STATUS: ${{res.statusCode}}`);
        completed++;
        if (completed === CONFIG.endpoints.length) {{
            process.exit(0);
        }}
    }});

    req.on('error', (e) => {{
        console.error(`[${{CONFIG.stamp}}] BROADCAST ERROR (${{targetParsed.hostname}}): ${{e.message}}`);
        completed++;
        if (completed === CONFIG.endpoints.length) {{
            process.exit(0);
        }}
    }});

    req.write(payload);
    req.end();
}});

setTimeout(() => {{
    process.exit(0);
}}, 5000);
"""
    with open("Protocols/IndexNowBroadcast.js", "w", encoding="utf-8") as f:
        f.write(js_content)

    print(f"[{ctx['stamp']}] DUAL OUTPUT GENERATED SUCCESSFULLY: .ehc & .js")

if __name__ == "__main__":
    context = auto_discover_context()
    generate_dual_outputs(context)
