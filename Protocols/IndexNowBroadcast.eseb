#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
[ESEB MASTER PROTOCOL SOURCE]
MODULE: IndexNowBroadcast
STAMP: V-STAMP-24 | ANCHOR: ¢24 | BRAND: DONABICO MEDIA SYSTEM
STANDARD: 04THU (Thực Dụng - Thực Tế - Thực Tiễn - Thực Chiến 100%)
AUTO-6D: Auto-Detect Repo & CNAME
"""

import os
import sys
import json

def auto_discover_context():
    repo = os.environ.get("GITHUB_REPOSITORY", "donabico-media-system/path-00001")
    repo_name = repo.split('/')[-1] if '/' in repo else "path-00001"
    domain = f"https://donabico.com/{repo_name}"
    
    if os.path.exists("CNAME"):
        try:
            with open("CNAME", "r", encoding="utf-8") as f:
                cname_val = f.read().strip()
                if cname_val:
                    cname_clean = cname_val.replace("https://", "").replace("http://", "").strip("/")
                    domain = f"https://{cname_clean}/{repo_name}"
        except Exception:
            pass
            
    return {
        "repo": repo,
        "domain": domain,
        "token": os.environ.get("CLASSIC_API_TOKEN", ""),
        "stamp": "V-STAMP-24",
        "anchor": "¢24"
    }

def generate_dual_outputs(ctx):
    os.makedirs("Protocols", exist_ok=True)
    
    # 0. Tự động sinh tệp Key IndexNow vật lý ở thư mục gốc repo để IndexNow Gateway xác thực thành công (Chống 403)
    key_val = "24242424242424242424242424242424"
    key_file_path = f"{key_val}.txt"
    with open(key_file_path, "w", encoding="utf-8") as f:
        f.write(key_val)

    # 1. Sinh Client Entity (.ehc) - Sạch Log F12, tiêm Favicon Base64 chặn 404
    ehc_content = f"""/* ESEB CLIENT LIVING ENTITY | {ctx['stamp']} | {ctx['anchor']} */
(function() {{
    'use strict';
    
    if (!document.querySelector("link[rel*='icon']")) {{
        const link = document.createElement('link');
        link.type = 'image/x-icon';
        link.rel = 'shortcut icon';
        link.href = 'data:image/x-icon;base64,AAABAAEAEBAAAAEAIABoBAAAFgAAACgAAAAQAAAAEAAAAAEAIAAAAAAAAAIAAAAAAAAAAAAAAAAAAAAAAAD///8A';
        document.getElementsByTagName('head')[0].appendChild(link);
    }}

    console.log("%c[{ctx['stamp']}] [SYSTEM_READY] Client Living Pulse 2.5s Active | Domain: {ctx['domain']}/", "color: #00ff00; font-weight: bold;");
    console.log("%c[{ctx['stamp']}] [BROADCAST_PASS] Global Gateway Broadcast Managed via Serverless Cloud Runner", "color: #00ffff; font-weight: bold;");

    setInterval(() => {{
        console.log(JSON.stringify({{
            pulse: "LIVE",
            stamp: "{ctx['stamp']}",
            anchor: "{ctx['anchor']}",
            domain: "{ctx['domain']}/",
            entropy: "0.00000000000000"
        }}));
    }}, 2500);
}})();
"""
    with open("Protocols/IndexNowBroadcast.ehc", "w", encoding="utf-8") as f:
        f.write(ehc_content)

    # 2. Sinh Serverless Runner Engine (.js) - Chuẩn Payload IndexNow 200/202
    js_content = f"""/* ESEB SERVERLESS RUNNER ENGINE | {ctx['stamp']} | {ctx['anchor']} */
const https = require('https');
const {{ URL }} = require('url');

const CONFIG = {{
    stamp: "{ctx['stamp']}",
    anchor: "{ctx['anchor']}",
    repo: "{ctx['repo']}",
    domain: "{ctx['domain']}",
    key: "{key_val}",
    endpoints: [
        "https://api.indexnow.org/indexnow",
        "https://googleapis.com"
    ]
}};

console.log(`[${{CONFIG.stamp}}] [${{CONFIG.anchor}}] STARTING SERVERLESS RUNNER BROADCAST PIPELINE...`);
console.log(`--> Target Custom Domain: ${{CONFIG.domain}}/`);

const parsedTargetDomain = new URL(CONFIG.domain);
const hostName = parsedTargetDomain.hostname;

const payload = JSON.stringify({{
    host: hostName,
    key: CONFIG.key,
    keyLocation: `${{CONFIG.domain}}/${{CONFIG.key}}.txt`,
    urlList: [
        `${{CONFIG.domain}}/`,
        `${{CONFIG.domain}}/sitemap.xml`
    ]
}});

let completed = 0;

CONFIG.endpoints.forEach((targetUrl) => {{
    const targetParsed = new URL(targetUrl);
    const options = {{
        hostname: targetParsed.hostname,
        port: 443,
        path: targetParsed.pathname,
        method: 'POST',
        headers: {{
            'Host': targetParsed.hostname,
            'Content-Type': 'application/json; charset=utf-8',
            'Content-Length': Buffer.byteLength(payload),
            'User-Agent': 'Mozilla/5.0 (compatible; ESEB-IndexNow-Runner/1.0)'
        }}
    }};

    const req = https.request(options, (res) => {{
        console.log(`[${{CONFIG.stamp}}] BROADCAST TO ${{targetParsed.hostname}} -> HTTP STATUS: ${{res.statusCode}}`);
        completed++;
        if (completed === CONFIG.endpoints.length) {{
            process.exit(0);
        }}
    }});

    req.on('error', (e) => {{
        console.error(`[${{CONFIG.stamp}}] BROADCAST ERROR (${{targetParsed.hostname}}): ${{e.message}}`);
        completed++;
        if (completed === CONFIG.endpoints.length) {{
            process.exit(0);
        }}
    }});

    req.write(payload);
    req.end();
}});

setTimeout(() => {{
    process.exit(0);
}}, 5000);
"""
    with open("Protocols/IndexNowBroadcast.js", "w", encoding="utf-8") as f:
        f.write(js_content)

    print(f"[{ctx['stamp']}] DUAL OUTPUT + INDEXNOW KEY GENERATED: {key_file_path} Created Successfully!")

if __name__ == "__main__":
    context = auto_discover_context()
    generate_dual_outputs(context)
